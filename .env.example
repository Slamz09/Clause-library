# =============================================================================
# Consola 360 — Environment Variables
# Copy this file to .env.local for local development.
# All variables without NEXT_PUBLIC_ prefix are server-only and never bundled
# into the client. Do not prefix secrets with NEXT_PUBLIC_.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------

# Base URL of this deployment. Must be https:// in production.
APP_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase
# Public vars (safe to expose to the browser)
# -----------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Server-only — never expose to the browser or commit to source control.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# -----------------------------------------------------------------------------
# LLM Providers (server-only)
# -----------------------------------------------------------------------------

# Primary LLM: Groq — llama-3.3-70b-versatile
GROQ_API_KEY=<groq-api-key>

# Failover LLM: Mistral — mistral-small-latest
MISTRAL_API_KEY=<mistral-api-key>

# Clause extraction: LlamaIndex Cloud (LlamaParse)
# Optional — only required if the LlamaParse extraction step is enabled.
LLAMA_CLOUD_API_KEY=<llamaindex-cloud-key>

# CARTO basemap tiles (Legal Regulations map, Compliance Gaps map).
# Free tier, 5M tile requests/month: https://carto.com/basemaps/apikey
NEXT_PUBLIC_CARTO_API_KEY=<carto-basemaps-api-key>

# Automatic document-type classification (bulk upload only — see
# lib/documents/classifyDocument.ts). Confidence is 0.0-1.0.
# >= AUTO threshold: classify automatically. >= REVIEW but < AUTO: classify,
# flagged "review recommended". < REVIEW: classified as Unknown.
# DOC_TYPE_AUTO_THRESHOLD=0.90
# DOC_TYPE_REVIEW_THRESHOLD=0.75

# -----------------------------------------------------------------------------
# Rate Limiting — Upstash Redis (server-only)
# Create a Redis database at https://console.upstash.com and copy these values.
# -----------------------------------------------------------------------------

UPSTASH_REDIS_REST_URL=https://<db-name>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<upstash-token>

# -----------------------------------------------------------------------------
# Seed / Internal Tools (server-only)
# -----------------------------------------------------------------------------

# Secret required by POST /api/seed. Generate a long random string.
# Example: openssl rand -base64 32
SEED_SECRET=<seed-secret>

# REQUIRED for clause auto-extraction to work at all — both bulk upload AND
# single-document upload's clause classification now goes through
# lib/documents/processDocumentUpload.ts making an internal server-to-server
# call to POST /api/documents/classify-clauses (no browser session to
# present, so it authenticates with this secret instead — see checkAuth() in
# that route). Also gates the internal bulk-upload worker
# (POST /api/documents/bulk-upload/process), called by the enqueue route and
# the Netlify scheduled poller (netlify/functions/bulk-upload-poller.ts).
# Without this set, uploaded documents will save with ZERO extracted clauses
# — check server logs for "classify-clauses call failed" if that happens.
# Generate a long random string, e.g.: openssl rand -base64 32
BULK_PROCESS_SECRET=<bulk-process-secret>

# -----------------------------------------------------------------------------
# Optional: Anthropic Claude (server-only)
# Used for optional Claude-backed features. Not required for core platform.
# -----------------------------------------------------------------------------

# ANTHROPIC_API_KEY=<anthropic-api-key>
